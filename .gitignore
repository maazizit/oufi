# Archives d'historique generees pour transferer le travail hors du conteneur.
# Elles contiennent les commits du depot lui-meme : les versionner reviendrait a
# embarquer une copie perimee de l'historique a chaque nouveau commit.
*.bundle

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
