# Variables d'environnement — copiez vers `.env.local`

# Supabase — projet cuwtknywzfyvhuuvvrpd
# Dashboard → Settings → API : Project URL + anon public
NEXT_PUBLIC_SUPABASE_URL=https://cuwtknywzfyvhuuvvrpd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Optionnel — CLI / migrations (Settings → Database → connection string)
# SUPABASE_ACCESS_TOKEN=sbp_...
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres

# Mot de passe back-office en mode démo (uniquement si Supabase n'est PAS configuré)
ADMIN_DEMO_PASSWORD=oufi-admin
