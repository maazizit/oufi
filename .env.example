# Variables d'environnement — copiez vers `.env.local`

# URL canonique du site
NEXT_PUBLIC_SITE_URL=https://amanplanet.com

# Supabase (obligatoire en production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase service role (server only, Vercel Sensitive)
# SUPABASE_SERVICE_ROLE_KEY=

# Mot de passe du compte admin Supabase (bootstrap + connexion)
ADMIN_PASSWORD=change-me-strong
# ADMIN_USER=admin  # optionnel, défaut admin → admin@amanplanet.local

# Chatbot site (server-only)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optionnel — GA4
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX
