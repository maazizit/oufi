# Variables d'environnement — copiez vers `.env.local`

# Supabase (obligatoire en production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Mot de passe back-office en mode démo (uniquement si Supabase n'est PAS configuré)
ADMIN_DEMO_PASSWORD=oufi-admin
